{
 "manifest_version":3,
 "name":"Smart UMN Planner",
 "version":"0.7.0",
 "minimum_chrome_version":"120",
 "description":"Personalized Twin Cities APAS program context and source-labeled insights rendered directly inside UMN Schedule Builder.",
 "permissions":["storage","alarms"],
 "host_permissions":["https://umn.uachieve.com/selfservice/*","https://schedulebuilder.umn.edu/*","http://127.0.0.1/*"],
 "background":{"service_worker":"background.js","type":"module"},
 "action":{"default_title":"Open Smart UMN Planner"},
 "content_scripts":[
  {"matches":["https://umn.uachieve.com/selfservice/*"],"js":["apas.js"],"run_at":"document_idle"},
  {"matches":["https://schedulebuilder.umn.edu/*"],"js":["schedule.js"],"run_at":"document_idle"},
  {"matches":["http://127.0.0.1/*"],"js":["bridge.js"],"run_at":"document_idle"}
 ],
 "content_security_policy":{"extension_pages":"script-src 'self'; object-src 'none'"}
}

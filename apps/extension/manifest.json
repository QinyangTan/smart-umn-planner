{
 "manifest_version": 3,
 "name": "Smart UMN Planner",
 "version": "0.10.4",
 "minimum_chrome_version": "120",
 "description": "Personalized Twin Cities APAS program context and source-labeled insights rendered directly inside UMN Schedule Builder.",
 "homepage_url": "https://smartumn.qinyangtan.com",
 "icons": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
 },
 "permissions": [
  "storage",
  "alarms"
 ],
 "host_permissions": [
  "https://umn.uachieve.com/selfservice/*",
  "https://schedulebuilder.umn.edu/*",
  "http://127.0.0.1/*"
 ],
 "background": {
  "service_worker": "background.js",
  "type": "module"
 },
 "action": {
  "default_title": "Open Smart UMN Planner",
  "default_icon": {
   "16": "icons/icon16.png",
   "32": "icons/icon32.png"
  }
 },
 "content_scripts": [
  {
   "matches": [
    "https://umn.uachieve.com/selfservice/*"
   ],
   "js": [
    "apas.js"
   ],
   "run_at": "document_idle"
  },
  {
   "matches": [
    "https://schedulebuilder.umn.edu/*"
   ],
   "js": [
    "schedule.js"
   ],
   "run_at": "document_idle"
  },
  {
   "matches": [
    "http://127.0.0.1/*"
   ],
   "js": [
    "bridge.js"
   ],
   "run_at": "document_idle"
  }
 ],
 "content_security_policy": {
  "extension_pages": "script-src 'self'; object-src 'none'"
 },
 "key": ""
}

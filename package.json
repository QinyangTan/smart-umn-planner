{
 "name": "smart-umn-planner",
 "version": "0.10.5",
 "private": true,
 "type": "module",
 "engines": {
  "node": ">=24"
 },
 "scripts": {
  "build": "node scripts/build.mjs",
  "dev": "npm run build && node apps/api/server.ts",
  "start": "node apps/api/server.ts",
  "test": "node --test tests/*.test.ts",
  "typecheck": "tsc --noEmit",
  "verify:live": "node scripts/verify-live.ts",
  "verify:majors": "node scripts/verify-majors.ts",
  "verify:browser": "node scripts/verify-browser.ts",
  "report:apas-compatibility": "node scripts/report-apas-compatibility.ts",
  "verify:apas-corpus": "node scripts/verify-apas-compatibility-corpus.ts",
  "report:apas-corpus": "node scripts/report-apas-corpus-coverage.ts",
  "report:course-coverage": "node scripts/report-course-intelligence-coverage.ts",
  "verify:course-coverage": "node scripts/verify-course-intelligence-coverage.ts",
  "add:apas-corpus": "node scripts/add-apas-compatibility-report.ts",
  "package:extension": "npm run build && node scripts/package-extension.ts",
  "record:demos": "npm run build && node scripts/record-demos.ts",
  "embeddings:warm": "node scripts/warm-policy-embeddings.ts",
  "policy:refresh": "node scripts/refresh-policy-sources.ts",
  "worker": "node apps/worker/cli.ts",
  "verify:release": "node scripts/verify-release.ts",
  "export:public-seed": "node scripts/export-public-evidence-seed.ts",
  "verify:production": "node scripts/verify-production.ts",
  "verify:a11y": "node scripts/verify-a11y.ts"
 },
 "devDependencies": {
  "@netlify/functions": "^6.0.0",
  "@types/chrome": "^0.3.0",
  "@types/jsdom": "^21.1.7",
  "@types/node": "^24.0.0",
  "axe-core": "^4.13.0",
  "esbuild": "^0.25.0",
  "jsdom": "^26.1.0",
  "playwright-core": "^1.63.0",
  "typescript": "^5.9.0"
 },
 "dependencies": {
  "@huggingface/transformers": "^4.3.0",
  "motion": "^13.4.4"
 }
}
